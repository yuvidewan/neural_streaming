@startuml Fig1_architecture_current
' Fig. 1. Architecture of the current codec (conditional coders, two-scale latent, GOP 30)
skinparam dpi 300
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #1F2933
skinparam ArrowThickness 1.3
skinparam nodesep 30
skinparam ranksep 28
skinparam rectangle {
  RoundCorner 12
  BorderThickness 1.6
  BackgroundColor<<io>> #EEF2F5
  BorderColor<<io>> #4B5563
  BackgroundColor<<intra>> #DCE9F6
  BorderColor<<intra>> #1F5C99
  BackgroundColor<<inter>> #FCE8D6
  BorderColor<<inter>> #B35C00
  BackgroundColor<<coder>> #DDF0E3
  BorderColor<<coder>> #2E7D4F
  BackgroundColor<<dec>> #E9E3F4
  BorderColor<<dec>> #5B3F8C
}
hide stereotype

rectangle "Input frames x<sub>t</sub>  (RGB; DAVIS 256×256, UVG 1920×1072)" <<io>> as IN
rectangle "GOP controller: I-frame every 30 frames, P-frames otherwise" <<io>> as GOP

rectangle "I-frame coder (9.05 M params)\nconditional coder fed a flat grey reference" <<intra>> as IC
rectangle "Two-scale latent: 64 ch at 1/16 + 32 ch at 1/8\nunit-step rounding, learned Laplace prior" <<intra>> as IL

rectangle "Bit-aware block motion: 16×16, ±16 px\nSAD + λ<sub>m</sub>·bits, median-predicted MV coding" <<inter>> as ME
rectangle "Warp x̂<sub>t−1</sub> → x<sub>warp</sub>  →  context network //F//\ncontext features c" <<inter>> as W
rectangle "Conditional P-frame coder (9.05 M params)\n//E//<sub>p</sub>(x<sub>t</sub>, c) → y (1/16) + detail y<sub>d</sub> (1/8)\nprior p(ŷ | c) = Laplace(μ, b)" <<inter>> as PC

rectangle "Optional encode-time latent tuning\n(20 Adam steps on D + λR, decoder unchanged)" <<coder>> as TUNE
rectangle "**Range coder (native C, 32-bit, byte-exact)**\nscales snapped to 64 Laplace tables" <<coder>> as RC
rectangle ".nvct container: header + model identities\n+ per-frame motion / latent lengths" <<coder>> as NV

rectangle "Decoder: synthesis //D//<sub>p</sub>(ŷ, ŷ<sub>d</sub>, c) + refine  →  reconstructed frame x̂<sub>t</sub>" <<dec>> as DEC
rectangle "Decoded reference buffer x̂<sub>t−1</sub>" <<dec>> as BUF

IN -down-> GOP
GOP -down-> IC : <color:#1F5C99>//Intra path (I-frame)//</color>
GOP -down-> ME : <color:#B35C00>//Inter path (P-frame)//</color>

IC -down-> IL
ME -down-> W
W -down-> PC

IL -down-> TUNE
PC -down-> TUNE
TUNE -down-> RC
RC -down-> NV
NV -down-> DEC
DEC -down-> BUF

' feedback: the decoded frame becomes the next P-frame's reference.
' Written right-to-left so it does not pull the Warp box below the buffer.
W <-[#5B3F8C,dashed]- BUF
@enduml
