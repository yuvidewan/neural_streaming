# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Compiled native extensions (auto-built on demand, see
# src/nvc/compression/_native/__init__.py - never commit the binary,
# only the .c source) ---
src/nvc/compression/_native/*.dll
src/nvc/compression/_native/*.dylib

# --- Virtual environment ---
.venv/
venv/
env/

# --- IDE / editor temp files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Secrets / environment files ---
.env
.env.*
*.pem
*.key

# --- Jupyter ---
.ipynb_checkpoints/

# --- Test / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Datasets and generated frames (kept out of git; large/regenerable) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# data/external holds extracted third-party datasets (e.g. DAVIS, and
# Vimeo-90K Septuplet under data/external/vimeo_septuplet/ - see README.md,
# "Large-Scale Training Dataset") - never committed, regardless of size.
data/external/*
!data/external/.gitkeep

# data/frames has train/val/test subfolders (Milestone 2); keep the
# subfolders themselves but ignore the (potentially huge) PNGs inside.
data/frames/*
!data/frames/train/
!data/frames/val/
!data/frames/test/
data/frames/train/*
!data/frames/train/.gitkeep
data/frames/val/*
!data/frames/val/.gitkeep
data/frames/test/*
!data/frames/test/.gitkeep

# --- Training / inference outputs (regenerable; can be large) ---
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/compressed/*
!outputs/compressed/.gitkeep
outputs/reconstructed/*
!outputs/reconstructed/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
# Codec calibration (quantization params + entropy model tables). Regenerable
# from a checkpoint via scripts/calibrate_quantizer.py, and large (a 64x256
# frequency table per bit depth).
outputs/calibration/*
!outputs/calibration/.gitkeep
outputs/visualizations/*
!outputs/visualizations/.gitkeep
# Benchmark runs (Milestone 7): timestamped result/plot directories plus
# intermediate encoded video and .nvc artifacts. Regenerable via
# scripts/benchmark_rd.py; can be large.
outputs/benchmarks/*
!outputs/benchmarks/.gitkeep
# The Stage 0 scoreboard is an analysis product, not a regenerable run dump:
# PARITY_ROADMAP.md's gate cites it. Small (JSON + plot + README).
!outputs/benchmarks/parity_s0/
# Same for the intra-only run: it is the denominator of the Stage 1 gate.
!outputs/benchmarks/parity_intra/
# QAT+control combined training output (Milestone 8B): checkpoints (already
# caught by *.pt below) plus progress_*.json/history.json, which are not.
# Auto-created by scripts/train_vimeo_qat_combined.py - no .gitkeep needed.
outputs/qat_combined/
# Stage 1 Vimeo training output (scripts/train_vimeo_stage1.py): checkpoints,
# progress.json, history.json, and the per-chunk Vimeo manifests - which are
# ~170k lines of regenerable run artifact, not an analysis product. All of it
# is rebuilt by re-running the script, so none of it belongs in git.
outputs/stage1_vimeo/

# Per-step training telemetry from the Milestone 10 experiments
# (scripts/m10*.py). One record per optimizer step x 18,120 steps ~= 9 MB per
# run, and 24 runs of it. Raw instrumentation, not an analysis product: every
# conclusion in CHANGELOG.md's M10A-M10E entries comes from the committed
# training_summary.json / rd_analysis.json / calibration + benchmark files
# alongside them. Regenerable by re-running the driver.
outputs/**/step_log.json

# Milestone 19's raw per-P-frame, per-latent-position diagnostic dump
# (scripts/m19_reference_error_diagnostic.py) - six large arrays per frame
# (error magnitude, assignment/symbol-changed flags, code lengths) stored as
# JSON text, ~140-150 MB per bit depth. Same category as step_log.json above:
# raw instrumentation, not an analysis product - every M19_REPORT.md
# conclusion comes from the committed m19_analysis.json/m19_baseline.json,
# which are pure reductions of this data. Regenerable by re-running the
# diagnostic against the same frozen checkpoint/calibration.
outputs/**/m19_raw_*bit.json

# --- Model checkpoint / export formats ---
*.pt
*.pth
*.ckpt
*.onnx

# --- Custom Neural Video Codec binary format ---
*.nvc
# .nvct is the M10G/M10H temporal prototype container (see
# scripts/m10h_motion_compensation.py). Same kind of artifact as .nvc:
# encoded bitstreams, regenerable from a checkpoint plus calibration, and
# large in bulk (M10F-M10J produced ~143 MB of them). The analysis JSON/CSV
# alongside them IS committed - every reported conclusion comes from those.
*.nvct
*.bin

# --- Video / image artifacts (raw footage, reconstructed output, frame dumps) ---
*.mp4
*.avi
*.mov
*.mkv
*.webm

# --- Logs and temp files ---
*.log
*.tmp

# --- Google Drive for Desktop's internal upload-staging cache, in case
# this repo ever ends up inside a Drive-backed-up folder ---
.tmp.driveupload/

# --- M22 research artifacts: regenerable caches and intermediate streams.
# The refitted checkpoints themselves are already covered by the repo-wide *.pt
# rule; their .provenance.json sidecars ARE committed, and those carry the
# SHA256, grid/calibration signatures and training identity needed to audit or
# re-fit any stack the M22 report cites. ---
outputs/m22_residual_freeze_lift/m22_train_residuals_*.pt
outputs/m22_residual_freeze_lift/*_streams/
